[Unit]
Description=Zhiyi Island Redis
After=network.target
[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/zhiyi-island/redis.conf
Restart=on-failure
RestartSec=5
MemoryMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhiyi-redis
[Install]
WantedBy=multi-user.target