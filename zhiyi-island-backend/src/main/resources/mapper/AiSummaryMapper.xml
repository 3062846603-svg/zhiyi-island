<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.zhiyiislandbackend.mapper.AiSummaryMapper">

    <resultMap id="BaseResultMap" type="com.example.zhiyiislandbackend.model.entity.AiSummary">
        <id column="id" property="id"/>
        <result column="note_id" property="noteId"/>
        <result column="user_id" property="userId"/>
        <result column="summary_content" property="summaryContent"/>
        <result column="summary_type" property="summaryType"/>
        <result column="summary_style" property="summaryStyle"/>
        <result column="summary_length" property="summaryLength"/>
        <result column="original_word_count" property="originalWordCount"/>
        <result column="summary_word_count" property="summaryWordCount"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, note_id, user_id, summary_content, summary_type, summary_style, summary_length,
        original_word_count, summary_word_count, create_time
    </sql>

    <insert id="insert" parameterType="com.example.zhiyiislandbackend.model.entity.AiSummary" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO ai_summary (note_id, user_id, summary_content, summary_type, summary_style, summary_length,
        original_word_count, summary_word_count, create_time)
        VALUES (#{noteId}, #{userId}, #{summaryContent}, #{summaryType}, #{summaryStyle}, #{summaryLength},
        #{originalWordCount}, #{summaryWordCount}, #{createTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ai_summary
        WHERE id = #{id}
    </select>

    <select id="selectLatestByNoteId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ai_summary
        WHERE note_id = #{noteId}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <select id="selectByNoteId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ai_summary
        WHERE note_id = #{noteId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ai_summary
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <delete id="deleteById">
        DELETE FROM ai_summary WHERE id = #{id}
    </delete>

    <delete id="deleteByNoteId">
        DELETE FROM ai_summary WHERE note_id = #{noteId}
    </delete>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM ai_summary WHERE user_id = #{userId}
    </select>

    <select id="countByNoteId" resultType="int">
        SELECT COUNT(*) FROM ai_summary WHERE note_id = #{noteId}
    </select>

</mapper>
