<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.zhiyiislandbackend.mapper.ExportRecordMapper">

    <resultMap id="BaseResultMap" type="com.example.zhiyiislandbackend.model.entity.ExportRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="export_type" property="exportType"/>
        <result column="format" property="format"/>
        <result column="file_size" property="fileSize"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.zhiyiislandbackend.model.entity.ExportRecord" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO export_record (user_id, export_type, format, file_size, create_time)
        VALUES (#{userId}, #{exportType}, #{format}, #{fileSize}, #{createTime})
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM export_record WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <delete id="deleteById">
        DELETE FROM export_record WHERE id = #{id}
    </delete>

</mapper>
